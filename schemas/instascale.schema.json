{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Application": {
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "javascript"
          ]
        },
        "framework": {
          "type": "string",
          "enum": [
            "express"
          ]
        },
        "services": {
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "language",
        "framework",
        "version"
      ]
    },
    "Config": {
      "properties": {
        "name": {
          "type": "string"
        },
        "application": {
          "$ref": "#/$defs/Application"
        },
        "environments": {
          "additionalProperties": {
            "$ref": "#/$defs/Environment"
          },
          "type": "object"
        },
        "ci": {
          "type": "string",
          "enum": [
            "github"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "application",
        "environments",
        "ci"
      ]
    },
    "Deploy": {
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "local",
            "aws"
          ]
        },
        "regions": {
          "items": {
            "type": "string",
            "enum": [
              "us-east-1"
            ]
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "target"
      ]
    },
    "Environment": {
      "properties": {
        "deploy": {
          "$ref": "#/$defs/Deploy"
        },
        "orchestrator": {
          "type": "string",
          "enum": [
            "kubernetes",
            "compose",
            "swarm"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "deploy",
        "orchestrator"
      ]
    },
    "Service": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "http",
            "postgres",
            "mysql",
            "mongo",
            "redis"
          ]
        },
        "version": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "env": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "type"
      ]
    }
  }
}