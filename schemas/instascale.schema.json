{
  "properties": {
    "pipeline": {
      "properties": {
        "lint": {
          "type": "boolean",
          "description": "Enable linting."
        },
        "test": {
          "type": "boolean",
          "description": "Enable testing."
        },
        "coverage": {
          "type": "boolean",
          "description": "Enable coverage."
        },
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ],
          "description": "The CI/CD provider."
        },
        "owner": {
          "type": "string",
          "description": "The repository owner."
        },
        "repo": {
          "type": "string",
          "description": "The repository name."
        }
      },
      "type": "object",
      "required": [
        "provider",
        "owner",
        "repo"
      ],
      "description": "CI/CD pipeline configuration."
    },
    "application": {
      "properties": {
        "services": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "http"
                    }
                  }
                },
                "then": {
                  "required": [
                    "port"
                  ]
                }
              }
            ],
            "properties": {
              "port": {
                "type": "integer",
                "maximum": 65535,
                "minimum": 1024,
                "description": "The service port."
              },
              "env": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object",
                "description": "The service environment variables."
              },
              "name": {
                "type": "string",
                "description": "The service name."
              },
              "type": {
                "type": "string",
                "enum": [
                  "http",
                  "postgres",
                  "mysql",
                  "mongo",
                  "redis"
                ],
                "description": "The service type."
              },
              "description": {
                "type": "string",
                "description": "The service description."
              },
              "version": {
                "type": "string",
                "description": "The service version."
              }
            },
            "type": "object",
            "required": [
              "name"
            ],
            "description": "Service configuration."
          },
          "type": "array",
          "description": "List of services in the application."
        },
        "version": {
          "type": "string",
          "description": "The application version."
        }
      },
      "type": "object",
      "required": [
        "language",
        "services"
      ],
      "description": "Application configuration."
    },
    "environments": {
      "additionalProperties": {
        "properties": {
          "deploy": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target": {
                      "const": "local"
                    }
                  },
                  "type": "object"
                },
                "then": {
                  "properties": {
                    "regions": {
                      "maxItems": 0
                    }
                  },
                  "type": "object"
                }
              },
              {
                "if": {
                  "properties": {
                    "target": {
                      "const": "aws"
                    }
                  },
                  "type": "object"
                },
                "then": {
                  "properties": {
                    "regions": {
                      "enum": [
                        "us-east-1",
                        "us-west-1"
                      ]
                    }
                  },
                  "type": "object",
                  "required": [
                    "regions"
                  ]
                }
              }
            ],
            "properties": {
              "target": {
                "type": "string",
                "enum": [
                  "local",
                  "aws"
                ],
                "description": "The deployment target."
              },
              "regions": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "description": "List of regions to deploy to."
              }
            },
            "type": "object",
            "required": [
              "target"
            ],
            "description": "Deploy configuration."
          },
          "orchestrator": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "kubernetes",
                  "compose",
                  "swarm"
                ],
                "description": "The orchestrator."
              },
              {
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "kubernetes",
                      "compose",
                      "swarm"
                    ],
                    "description": "The orchestrator type."
                  },
                  "version": {
                    "type": "string",
                    "description": "The language-specific framework version."
                  }
                },
                "type": "object",
                "required": [
                  "type"
                ],
                "description": "The orchestrator."
              }
            ],
            "type": "object",
            "description": "Orchestrator configuration."
          }
        },
        "type": "object",
        "required": [
          "deploy",
          "orchestrator"
        ],
        "description": "Environment configuration."
      },
      "type": "object",
      "description": "The project environments."
    },
    "name": {
      "type": "string",
      "description": "The project name."
    },
    "vcs": {
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github"
          ],
          "description": "The VCS provider."
        },
        "owner": {
          "type": "string",
          "description": "The repository owner."
        },
        "repo": {
          "type": "string",
          "description": "The repository name."
        },
        "visibility": {
          "type": "string",
          "description": "The repository visibility."
        }
      },
      "type": "object",
      "required": [
        "provider",
        "owner",
        "repo"
      ],
      "description": "Version Control System configuration."
    }
  },
  "type": "object",
  "required": [
    "name",
    "application",
    "environments"
  ],
  "description": "Project configuration."
}