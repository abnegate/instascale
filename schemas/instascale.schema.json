{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Application": {
      "properties": {
        "language": {
          "$ref": "#/$defs/Language"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "language"
      ]
    },
    "Config": {
      "properties": {
        "name": {
          "type": "string"
        },
        "vcs": {
          "$ref": "#/$defs/VCS"
        },
        "pipeline": {
          "$ref": "#/$defs/Pipelines"
        },
        "application": {
          "$ref": "#/$defs/Application"
        },
        "environments": {
          "additionalProperties": {
            "$ref": "#/$defs/Environment"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "application",
        "environments"
      ]
    },
    "Deploy": {
      "properties": {
        "target": {
          "type": "string"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "target"
      ]
    },
    "Environment": {
      "properties": {
        "deploy": {
          "$ref": "#/$defs/Deploy"
        },
        "orchestrator": {
          "$ref": "#/$defs/Orchestrator"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "deploy",
        "orchestrator"
      ]
    },
    "Framework": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "version"
      ]
    },
    "Language": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "framework": {
          "$ref": "#/$defs/Framework"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "framework"
      ]
    },
    "Orchestrator": {
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "Pipelines": {
      "properties": {
        "provider": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "lint": {
          "type": "boolean"
        },
        "test": {
          "type": "boolean"
        },
        "coverage": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "provider",
        "owner",
        "repo",
        "lint",
        "test",
        "coverage"
      ]
    },
    "Service": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "type"
      ]
    },
    "VCS": {
      "properties": {
        "provider": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "provider",
        "owner",
        "repo",
        "visibility"
      ]
    }
  }
}